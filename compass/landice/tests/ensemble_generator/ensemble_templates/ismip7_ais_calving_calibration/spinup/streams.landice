<streams>

<immutable_stream name="basicmesh"
                  type="none"
                  filename_template="not-to-be-used.nc"/>

<immutable_stream name="input"
                  type="input"
                  filename_template="/global/cfs/cdirs/fanssie/MALI_projects/ISMIP6-2300/initial_conditions/AIS_4to20km_20230105/relaxation_0TGmelt_10yr/relaxed_10yrs_4km.nc"
                  input_interval="initial_only"/>

<immutable_stream name="restart"
                  type="input;output"
                  filename_template="rst.$Y-$M-$D.nc"
                  filename_interval="output_interval"
                  reference_time="2000-01-01_00:00:00"
                  clobber_mode="overwrite"
                  precision="double"
                  input_interval="initial_only"
                  output_interval="0001-00-00_00:00:00"/>

<stream name="output"
        type="output"
        filename_template="output/output_state_$Y.nc"
        filename_interval="005-00-00_00:00:00"
        reference_time="2000-01-01_00:00:00"
        clobber_mode="overwrite"
        precision="double"
        output_interval="0001-00-00_00:00:00">

    <stream name="basicmesh"/>
    <var_struct name="timeAveraging"/>
    <var name="xtime"/>
    <var name="simulationStartTime"/>
    <var name="thickness"/>
    <var name="lowerSurface"/>
    <var name="upperSurface"/>
    <var name="bedTopography"/>
    <var name="uReconstructX"/>
    <var name="uReconstructY"/>
    <var name="surfaceSpeed"/>
    <var name="xvelmean"/>
    <var name="yvelmean"/>
    <var name="basalTemperature"/>
    <var name="surfaceTemperature"/>
    <var name="betaSolve"/>
    <var name="daysSinceStart"/>
    <var name="cellProcID"/>
    <var name="cellMask"/>
    <var name="deltat"/>
    <var name="vonMisesStress"/>
    <var name="damage"/>
</stream>

<stream name="regionsInput"
        type="input"
        filename_template="/global/cfs/cdirs/fanssie/MALI_projects/ISMIP6-2300/initial_conditions/AIS_4to20km_20230105/AIS_4to20km_r01_20220907.regionMask_ismip6.nc"
        input_interval="initial_only"
        runtime_format="single_file">

    <var name="regionCellMasks"/>
</stream>

<stream name="globalStatsOutput"
        type="output"
        filename_template="output/globalStats_$Y.nc"
        filename_interval="0001-00-00_00:00:00"
        reference_time="2000-01-01_00:00:00"
        clobber_mode="overwrite"
        packages="globalStatsAMPKG"
        output_interval="0000-00-00_01:00:00"
        runtime_format="single_file">

    <var_struct name="globalStatsAM"/>
    <var name="xtime"/>
    <var name="simulationStartTime"/>
    <var name="daysSinceStart"/>
    <var name="deltat"/>
    <var name="allowableDtACFL"/>
    <var name="allowableDtDCFL"/>
    <var name="albanyVelocityError"/>
</stream>

<stream name="regionalStatsOutput"
        type="output"
        filename_template="output/regionalStats_$Y.nc"
        filename_interval="0001-00-00_00:00:00"
        reference_time="2000-01-01_00:00:00"
        clobber_mode="overwrite"
        packages="regionalStatsAMPKG"
        output_interval="0000-00-00_01:00:00"
        runtime_format="single_file">

    <var_struct name="regionalStatsAM"/>
    <var name="xtime"/>
    <var name="deltat"/>
    <var name="daysSinceStart"/>
    <var name="simulationStartTime"/>
</stream>

<stream name="ismip7_smb"
        type="input"
        filename_template="/global/cfs/cdirs/m4288/users/trhille/ISMIP7/test_processing/AIS/CESM2-WACCM_historical/atmosphere/AIS_4to20km_r01_20220907_SMB_CESM2-WACCM_historical_1980-2015.nc"
        input_interval="0000-01-00_00:00:00"
        reference_time="2000-01-01_00:00:00"
        runtime_format="single_file">

    <var name="sfcMassBal"/>
</stream>

<stream name="ismip7_temperature"
        type="input"
        filename_template="/global/cfs/cdirs/m4288/users/trhille/ISMIP7/test_processing/AIS/CESM2-WACCM_historical/atmosphere/AIS_4to20km_r01_20220907_temperature_CESM2-WACCM_historical_1980-2015.nc"
        input_interval="0000-01-00_00:00:00"
        reference_time="2000-01-01_00:00:00"
        runtime_format="single_file">

    <var name="surfaceAirTemperature"/>
</stream>

<stream name="ismip7_smb_gradient"
        type="input"
        filename_template="/global/cfs/cdirs/m4288/users/trhille/ISMIP7/test_processing/AIS/CESM2-WACCM_historical/atmosphere/AIS_4to20km_r01_20220907_SMB_gradient_CESM2-WACCM_historical_1980-2015.nc"
        input_interval="0001-00-00_00:00:00"
        reference_time="2000-01-01_00:00:00"
        runtime_format="single_file">

    <var name="sfcMassBalLapseRate"/>
</stream>

<stream name="ismip7_temperature_gradient"
        type="input"
        filename_template="/global/cfs/cdirs/m4288/users/trhille/ISMIP7/test_processing/AIS/CESM2-WACCM_historical/atmosphere/AIS_4to20km_r01_20220907_temperature_gradient_CESM2-WACCM_historical_1980-2015.nc"
        input_interval="0001-00-00_00:00:00"
        reference_time="2000-01-01_00:00:00"
        runtime_format="single_file">

    <var name="surfaceAirTemperatureLapseRate"/>
</stream>

<stream name="ismip7_TF"
        type="input"
        filename_template="/global/cfs/cdirs/m4288/users/trhille/ISMIP7/test_processing/AIS/CESM2-WACCM_historical/ocean_thermal_forcing/AIS_4to20km_r01_20220907_thermal_forcing_CESM2-WACCM_historical_1980-2015.nc"
        input_interval="0001-00-00_00:00:00"
        reference_time="2000-01-01_00:00:00"
        runtime_format="single_file">

    <var name="ismip6shelfMelt_3dThermalForcing"/>
    <var name="ismip6shelfMelt_zOcean"/>
</stream>

<stream name="ismip7_runoff"
        type="input"
        filename_template="/global/cfs/cdirs/m4288/users/trhille/ISMIP7/test_processing/AIS/CESM2-WACCM_historical/atmosphere/AIS_4to20km_r01_20220907_runoff_CESM2-WACCM_historical_1980-2015.nc"
        input_interval="0000-01-00_00:00:00"
        reference_time="2000-01-01_00:00:00"
        runtime_format="single_file">

    <var name="ismip6Runoff"/>
</stream>

<stream name="ismip7_params"
        type="input"
        filename_template="/global/cfs/cdirs/m4288/users/trhille/ISMIP7/test_processing/AIS/climatology/basin_and_coeff_DeltaT_quadratic_non_local_gamma14500.nc"
        input_interval="initial_only"
        runtime_format="single_file">

    <var name="ismip6shelfMelt_deltaT"/>
    <var name="ismip6shelfMelt_basin"/>
    <var name="ismip6shelfMelt_gamma0"/>
</stream>

<stream name="reference_surface"
        type="input"
        filename_template="/global/cfs/cdirs/m4288/users/trhille/ISMIP7/forcing/AIS/upper_surface.nc"
        input_interval="initial_only"
        runtime_format="single_file">

    <var name="surfaceElevationRef"/>
</stream>

</streams>
