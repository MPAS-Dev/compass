<streams>

<immutable_stream name="restart"
                  output_interval="0000-00-01_00:00:00"
                  reference_time="2000-01-01_00:00:00"/>

<stream name="output"
        output_interval="0000-00-01_00:00:00"
        reference_time="2000-01-01_00:00:00"
        clobber_mode="truncate">
    <var name="calvingVelocity"/>
    <var name="calvingThickness"/>
    <var name="floatingBasalMassBal"/>
</stream>

</streams>
